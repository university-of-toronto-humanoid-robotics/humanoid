<?xml version="1.0"?>
<package format="3">
  <name>height_scan</name>
  <version>0.0.0</version>
  <description>Turns the elevation map into the height scan the G1 competition policy was trained on.</description>
  <maintainer email="rodean.moradi@gmail.com">Rodean Moradi</maintainer>
  <license>BSD</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>grid_map_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
