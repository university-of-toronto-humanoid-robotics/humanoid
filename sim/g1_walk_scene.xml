<mujoco model="g1_walk_scene">
  <!-- The policy-training G1 in the LiDAR room, for bridge/mujoco_g1_walk_sim.py. That node adds the actuators,
       armature, contact settings, solver options and Mid-360 the way mjlab does, so this file only places things. -->
  <include file="../description/g1/g1_29dof_mjlab.xml"/>
  <compiler meshdir="../description/g1/meshes"/>

  <asset>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>

  <include file="lidar_room.xml"/>
</mujoco>
